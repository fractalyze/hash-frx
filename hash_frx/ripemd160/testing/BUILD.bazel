load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The plain-python RIPEMD-160 oracle: ints and bytes only, no frx, so the
# differential tests hold the frx implementation to something that shares none
# of its lowering rules.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: plain python against the designers' published vectors
# (million-"a" included), so the CUDA plugin wheels would be ~430 MB of
# runfiles for nothing.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        requirement("absl_py"),
    ],
)

# Testonly, unlike the SHA-2/SHA-3 host siblings: OpenSSL 3 moved RIPEMD-160
# to the legacy provider, so no dependable C binding exists and this one loops
# the plain-python oracle — the differential partner only, never a shipped
# fast path (the `grostl/testing:host_grostl256` asymmetry, stated in the
# module docstring).
py_library(
    name = "host_ripemd160",
    testonly = True,
    srcs = [
        "__init__.py",
        "host_ripemd160.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
    deps = [
        ":reference",
        "//hash_frx:byte_hash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_test(
    name = "ripemd160_test",
    # Compile-heavy relative to its arithmetic: the vector rows and the
    # differential sweep each compile the unrolled 160-step digest body once
    # per (batch, length) aval.
    size = "medium",
    srcs = ["ripemd160_test.py"],
    deps = [
        ":host_ripemd160",
        ":reference",
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/ripemd160",
        "//hash_frx/testing:jit_cache",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
