load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# Byte-oriented RIPEMD-160 (Dobbertin–Bosselaers–Preneel, ISO/IEC 10118-3;
# Bitcoin HASH160's second half): the `digest` batch hash behind the
# `hash_frx.digest.ripemd160` marker plus the `Ripemd160` ByteHash row. A
# standalone hash, not a Permutation; no zk_dtypes / x64 dependency. No host
# row ships — OpenSSL 3 moved RIPEMD-160 to the legacy provider, so the
# differential partner is testonly (//hash_frx/ripemd160/testing:host_ripemd160).
py_library(
    name = "ripemd160",
    srcs = [
        "__init__.py",
        "ripemd160.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx:word",
        "//hash_frx/extension:md",
        "//hash_frx/extension:pad",
        requirement("frx"),
        requirement("numpy"),
    ],
)
