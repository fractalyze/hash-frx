load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "sm3_test",
    # The fori_loop round body keeps the trace small (the sha256/sha512
    # arrangement), so this compiles fast relative to the unrolled digests.
    size = "medium",
    srcs = ["sm3_test.py"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/sha256",
        "//hash_frx/sm3",
        "//hash_frx/testing:jit_cache",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
