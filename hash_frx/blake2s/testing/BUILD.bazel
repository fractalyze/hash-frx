load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "blake2s_test",
    # Compile-heavy relative to its arithmetic, like the family's other
    # unrolled digests: the vector rows and the differential sweep each
    # compile the 80-G unrolled body once per (batch, length) aval, and the
    # GPU leg repeats it.
    size = "large",
    srcs = ["blake2s_test.py"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/blake2s",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_recognized",
        "//hash_frx/testing:oracle",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
