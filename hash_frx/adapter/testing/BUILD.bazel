load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# 48s on the GPU leg against a 60s cap while it was `small` — HMAC runs two
# digests per call over a device row, so the cost is the backend's, not the
# construction's.
py_test(
    name = "hmac_test",
    size = "medium",
    srcs = ["hmac_test.py"],
    deps = [
        "//hash_frx/adapter:hmac",
        "//hash_frx/blake3",
        "//hash_frx/sha256",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# 57s on the GPU leg against a 60s cap while it was `small`, which is a 3-second
# margin and is why it timed out under CI contention rather than occasionally.
# Expand is a dependency chain of HMAC calls, so it pays that cost per block.
py_test(
    name = "hkdf_test",
    size = "medium",
    srcs = ["hkdf_test.py"],
    deps = [
        "//hash_frx/adapter:hkdf",
        "//hash_frx/adapter:hmac",
        "//hash_frx/sha256",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "pbkdf2_test",
    # The BIP-39 case runs a real c = 2048 chain and the differentials spin
    # traced loops per (profile, c, dk_len) cell — loop-heavy rather than
    # compile-heavy.
    size = "medium",
    srcs = ["pbkdf2_test.py"],
    deps = [
        "//hash_frx/adapter:hmac",
        "//hash_frx/adapter:pbkdf2",
        "//hash_frx/blake2s",
        "//hash_frx/sha256",
        "//hash_frx/sha512",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# No device work: the lookup is host arithmetic over a row's type. Deps the row
# modules it names because the table is keyed by their class names — an entry
# that stopped matching a real row is exactly what this catches.
py_test(
    name = "block_size_test",
    size = "small",
    srcs = ["block_size_test.py"],
    deps = [
        "//hash_frx/adapter:block_size",
        "//hash_frx/ascon",
        "//hash_frx/blake2b",
        "//hash_frx/blake2s",
        "//hash_frx/blake3",
        "//hash_frx/grostl",
        "//hash_frx/keccak",
        "//hash_frx/ripemd160",
        "//hash_frx/sha256",
        "//hash_frx/sha512",
        "//hash_frx/sm3",
        "//hash_frx/testing:rows",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

# Held to `hashlib` block by block rather than to a second MGF1 — RFC 8017
# publishes no vectors, and the module docstring records why that is the
# stronger oracle anyway.
py_test(
    name = "mgf1_test",
    size = "medium",
    srcs = ["mgf1_test.py"],
    deps = [
        "//hash_frx/adapter:mgf1",
        "//hash_frx/keccak",
        "//hash_frx/sha256",
        "//hash_frx/sha512",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The pairing table against `testing/rows.py`, plus the selection over it.
# Deps the registry and the row modules the selection cases name; the digests
# themselves are `row_conformance_test`'s, so nothing here re-checks bytes.
py_test(
    name = "dual_test",
    size = "small",
    srcs = ["dual_test.py"],
    deps = [
        "//hash_frx/adapter:dual",
        "//hash_frx/blake3",
        "//hash_frx/keccak",
        "//hash_frx/sha256",
        "//hash_frx/testing:rows",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The alias against the rows it claims to cover. No device work of its own —
# every case reads `digest_size` off a freshly built row — but the device
# families are built, so the plugin deps ride along.
py_test(
    name = "xof_test",
    size = "small",
    srcs = ["xof_test.py"],
    deps = [
        "//hash_frx/adapter:mgf1",
        "//hash_frx/adapter:xof",
        "//hash_frx/ascon",
        "//hash_frx/blake2b",
        "//hash_frx/blake2s",
        "//hash_frx/blake3",
        "//hash_frx/keccak",
        "//hash_frx/sha256",
        "//hash_frx/testing:rows",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

# Both convention members against vectors generated by RUNNING the two crates
# (reference/README.md). The vector file is data, not a generated target: the
# generator needs a Rust toolchain and a network fetch, neither of which the
# Python legs have.
py_test(
    name = "duplex_test",
    size = "medium",
    srcs = ["duplex_test.py"],
    data = ["reference/ark_duplex_vectors.json"],
    deps = [
        "//hash_frx:duplex_sponge",
        "//hash_frx/adapter:duplex",
        "//hash_frx/poseidon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
