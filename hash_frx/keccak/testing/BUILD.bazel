load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Plain-python FIPS 202, the oracle permutation_test is held to.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: pure python against hashlib, so the CUDA plugin wheels would
# be ~430 MB of runfiles for nothing.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        requirement("absl_py"),
    ],
)

py_test(
    name = "fips202_test",
    # `_permute_body` traces once and every block and batch size reuses it, so
    # the eager sweeps are cheap however many shapes they cover. Compile is what
    # costs, and it scales with absorb-block count because `inline=True` splices
    # the 24 rounds in per block — which is why the traced cases stay sub-rate.
    size = "medium",
    srcs = ["fips202_test.py"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permutation_test",
    # Compile-heavy: 24 unrolled rounds over the lane grid.
    size = "medium",
    srcs = ["permutation_test.py"],
    deps = [
        ":reference",
        "//hash_frx:fusion",
        "//hash_frx:permutation",
        "//hash_frx/keccak",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:jit_cache",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
