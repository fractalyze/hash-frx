load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Plain-python FIPS 202, the oracle permutation_test is held to.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: pure python against hashlib, so the CUDA plugin wheels would
# be ~430 MB of runfiles for nothing.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        requirement("absl_py"),
    ],
)

py_test(
    name = "byte_hashes_test",
    # `_permute_body` traces once and every block and batch size reuses it, so
    # the eager sweeps are cheap however many shapes they cover. Compile is what
    # costs, and it scales with absorb-block count because `inline=True` splices
    # the 24 rounds in per block — which is why the traced cases stay sub-rate.
    size = "medium",
    srcs = ["byte_hashes_test.py"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sponge_test",
    # Compile-heavy for the same reason as `permutation_test`: the marked path
    # splices 24 unrolled rounds per absorbed block, and the two-block case is
    # deliberate — one block would not show the glue the marker exists to take.
    size = "medium",
    srcs = ["sponge_test.py"],
    deps = [
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        "//hash_frx/testing:marker_recognized",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permutation_test",
    # Compile-heavy: 24 unrolled rounds over the lane grid.
    size = "medium",
    srcs = ["permutation_test.py"],
    deps = [
        ":reference",
        "//hash_frx:fusion",
        "//hash_frx:permutation",
        "//hash_frx/keccak",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_recognized",
        "//hash_frx/testing:marker_seam",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "keccak256_test",
    # Compile-heavy for the same reason as its siblings: a device digest inlines
    # 24 unrolled rounds per absorb block.
    size = "medium",
    srcs = ["keccak256_test.py"],
    deps = [
        ":reference",
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "streaming_test",
    # Compile-heavy: each absorb and squeeze inlines the marked permutation once
    # per block of its static upper bound.
    size = "medium",
    srcs = ["streaming_test.py"],
    deps = [
        "//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
