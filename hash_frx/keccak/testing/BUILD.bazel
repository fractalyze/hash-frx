load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Plain-python FIPS 202, the oracle permutation_test is held to.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: pure python against hashlib, so the CUDA plugin wheels would
# be ~430 MB of runfiles for nothing.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        requirement("absl_py"),
    ],
)

py_test(
    name = "byte_hashes_test",
    # `_permute_body` traces once and every block and batch size reuses it, so
    # the eager sweeps are cheap however many shapes they cover. Compile is what
    # costs, and it scales with absorb-block count because `inline=True` splices
    # the 24 rounds in per block — which is why the traced cases stay sub-rate.
    #
    # `timeout = "long"` rather than `size = "large"`: the footprint is one
    # ordinary Python process, so what this needs is wall clock, not a bigger
    # resource class — `blake3_test` spells the same distinction the same way.
    # It earned it by growing: the two FIPS 202 rows added in #350 join a case
    # table every sweep runs over, and nothing re-sized the target. Measured on
    # the CI executor it takes 173-272 s against `medium`'s 300 s ceiling, and
    # that spread is the same test on different workers — so a cache miss on a
    # slow one times out, which is what it did.
    size = "medium",
    timeout = "long",
    srcs = ["byte_hashes_test.py"],
    deps = [
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sponge_test",
    # Compile-heavy for the same reason as `permutation_test`: the marked path
    # splices 24 unrolled rounds per absorbed block, and the two-block case is
    # deliberate — one block would not show the glue the marker exists to take.
    size = "medium",
    srcs = ["sponge_test.py"],
    deps = [
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:marker_recognized",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permutation_test",
    # Compile-heavy: 24 unrolled rounds over the lane grid.
    size = "medium",
    srcs = ["permutation_test.py"],
    deps = [
        ":reference",
        "//hash_frx:fusion",
        "//hash_frx:permutation",
        "//hash_frx/keccak",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_recognized",
        "//hash_frx/testing:marker_seam",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "keccak256_test",
    # Compile-heavy for the same reason as its siblings: a device digest inlines
    # 24 unrolled rounds per absorb block.
    size = "medium",
    srcs = ["keccak256_test.py"],
    deps = [
        ":reference",
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx/keccak",
        "//hash_frx/testing:oracle",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "streaming_test",
    # Compile-heavy: each absorb and squeeze inlines the marked permutation once
    # per block of its static upper bound.
    size = "medium",
    srcs = ["streaming_test.py"],
    deps = [
        "//hash_frx/keccak",
        "//hash_frx/testing:marker_recognized",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# SP 800-185 §2.3's encodings. Host-only and substrate-free — the module under
# test pulls no frx, so this target takes neither the frx requirement nor the
# GPU plugin, which is itself part of what the suite asserts.
py_test(
    name = "encodings_test",
    size = "small",
    srcs = ["encodings_test.py"],
    deps = [
        "//hash_frx/keccak:encodings",
        requirement("absl_py"),
    ],
)

# cSHAKE against SP 800-185 section 3. Medium rather than small, and NOT because
# of the plain-Python oracle — that is 42 calls and 0.03 s of the run. The cost
# is re-tracing the fused sponge composite, which keys on
# (rate, output_size, block count) at roughly 1.5 s a key. That is why the
# sweeps are unions rather than cross products; adding an output size is the
# expensive edit here, adding a message length is nearly free.
py_test(
    name = "cshake_test",
    # Same headroom as `byte_hashes_test` above, for the same measured reason:
    # 176 s on the CI executor, and the observed worker-to-worker spread on this
    # family is wide enough to carry that past 300 s.
    size = "medium",
    timeout = "long",
    srcs = ["cshake_test.py"],
    deps = [
        ":reference",
        "//hash_frx/keccak",
        "//hash_frx/keccak:encodings",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# KMAC against SP 800-185 section 4. Medium for `cshake_test`'s reason: the cost
# is re-tracing the fused sponge per (rate, output_size, block count), not the
# plain-Python oracle the bits-not-bytes check drives.
py_test(
    name = "kmac_test",
    # The `timeout = "long"` the two targets above carry, for the same reason:
    # the CI executor's worker-to-worker spread on this family reaches past
    # `medium`'s 300 s ceiling for a suite that runs well under it locally.
    size = "medium",
    timeout = "long",
    srcs = ["kmac_test.py"],
    deps = [
        ":reference",
        "//hash_frx/keccak",
        "//hash_frx/keccak:encodings",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# TupleHash against SP 800-185 section 5. `timeout = "long"` for the reason the
# three targets above carry it: the cost is re-tracing the fused sponge per
# distinct shape, and the CI executor's spread on this family reaches past
# `medium`'s 300 s ceiling.
py_test(
    name = "tuple_hash_test",
    size = "medium",
    timeout = "long",
    srcs = ["tuple_hash_test.py"],
    deps = [
        ":reference",
        "//hash_frx:byte_hash",
        "//hash_frx/keccak",
        "//hash_frx/keccak:encodings",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
