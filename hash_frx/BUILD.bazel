load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# The package marker. Carries `__version__`, which dev-release stamps; the
# primitive libraries (Poseidon, SHA-256, BLAKE3, Keccak) land alongside it and
# depend on this for the package init.
py_library(
    name = "hash_frx",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
)

# The one place `lax.composite` is spelled — every marker in this package routes
# through it.
py_library(
    name = "_composite",
    srcs = ["_composite.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

py_library(
    name = "fusion",
    srcs = ["fusion.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("frx"),
    ],
)

# The two seams a consumer codes against: a fixed-width permutation over a field
# dtype, and its byte sibling. Neither names a concrete hash.
py_library(
    name = "permutation",
    srcs = ["permutation.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

py_library(
    name = "byte_hash",
    srcs = ["byte_hash.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "linear",
    srcs = ["linear.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# Byte-oriented SHA-256 (FIPS 180-4): the `digest` batch hash plus the `Sha256` /
# `HostSha256` ByteHash implementations. A standalone hash, not a Permutation; no
# zk_dtypes / x64 dependency.
py_library(
    name = "sha256",
    srcs = ["sha256.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Padding-free overwrite sponge — the Merkle leaf hasher over a Permutation.
py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        ":permutation",
        requirement("frx"),
    ],
)

# Add-absorb duplex sponge — the interleaved absorb/squeeze sibling of `Sponge`,
# the primitive a Fiat-Shamir transcript drives.
py_library(
    name = "duplex_sponge",
    srcs = ["duplex_sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("frx"),
    ],
)

# Truncated-permutation compression — the n-to-1 Merkle fold over a Permutation.
py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("frx"),
    ],
)
