load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# The package marker and the public API. Carries `__version__`, which
# dev-release stamps, and the lazy re-exports every consumer imports through.
#
# The deps are what make `from hash_frx import Sha256` resolve for a Bazel
# consumer: the re-export is lazy in Python, but the module it reaches for still
# has to be in runfiles, and a consumer that deps only on this target has no
# other way to get it. That is why the list is the whole package rather than a
# subset — a missing entry fails at run time, in the consumer, on the one name
# nobody exercised.
#
# It is deliberately NOT the plugin deps (`defs.bzl`'s GPU_PLUGIN_DEPS): nothing
# here initializes a device, and `package_test` pins that importing this target
# imports no hash at all.
py_library(
    name = "hash_frx",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":blake2s",
        ":byte_hash",
        ":compression",
        ":duplex_sponge",
        ":fusion",
        ":hkdf",
        ":hmac",
        ":markers",
        ":pbkdf2",
        ":permutation",
        ":ripemd160",
        ":sha256",
        ":sha512",
        ":sm3",
        ":sponge",
        "//hash_frx/ascon",
        "//hash_frx/blake2b",
        "//hash_frx/blake3",
        "//hash_frx/extension:md",
        "//hash_frx/grostl",
        "//hash_frx/keccak",
        "//hash_frx/poseidon",
        "//hash_frx/poseidon2",
        "//hash_frx/vision",
    ],
)

# `__init__.py` alone, with none of the package's dependencies. `package_test`
# needs exactly this: it imports the package — which, being lazy, pulls no hash —
# and reads nothing else. Depending on `//hash_frx` there would drag every pip
# requirement into a 4 ms test's runfiles, measured at +595 MB / +3347 files,
# larger than the GPU plugin deps `defs.bzl` already calls too expensive to
# attach reflexively.
#
# With frx absent from those runfiles the laziness is enforced rather than
# merely asserted: an eager re-export cannot quietly initialize a backend here,
# it fails to import at all.
py_library(
    name = "package_init",
    srcs = ["__init__.py"],
    visibility = ["//hash_frx:__subpackages__"],
)

# The one place `lax.composite` is spelled — every marker in this package routes
# through it.
py_library(
    name = "_composite",
    srcs = ["_composite.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

py_library(
    name = "fusion",
    srcs = ["fusion.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("frx"),
    ],
)

# The registry of every composite marker this package owns (name, version,
# axis) — data only, no hash imports, so a consumer can read the wire surface
# without pulling every hash's dependencies. `markers_test` holds the rows to
# the emitting modules' constants.
py_library(
    name = "markers",
    srcs = ["markers.py"],
    visibility = ["//visibility:public"],
)

# The two seams a consumer codes against: a fixed-width permutation over a field
# dtype, and its byte sibling. Neither names a concrete hash.
py_library(
    name = "permutation",
    srcs = ["permutation.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        requirement("frx"),
    ],
)

py_library(
    name = "byte_hash",
    srcs = ["byte_hash.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "linear",
    srcs = ["linear.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# `linear.py`'s counterpart for the bit-oriented families: the uint32 rotate,
# the static roll, and the little-endian byte/word packers.
py_library(
    name = "word",
    srcs = ["word.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# `word.py`'s 64-bit sibling: the `(lo, hi)` uint32 half-pair helpers the
# 64-bit-word hashes share (SHA-512's Σ/σ chain, BLAKE2b's G).
py_library(
    name = "word64",
    srcs = ["word64.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# Byte-oriented SHA-256 (FIPS 180-4): the `digest` batch hash plus the `Sha256` /
# `HostSha256` ByteHash implementations. A standalone hash, not a Permutation; no
# zk_dtypes / x64 dependency.
py_library(
    name = "sha256",
    srcs = ["sha256.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        ":word",
        "//hash_frx/extension:md",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Byte-oriented SHA-512 (FIPS 180-4): SHA-256's 64-bit sibling over uint32 half
# pairs — the `digest` batch hash behind the `hash_frx.digest.sha512` marker
# plus the `Sha512` / `HostSha512` ByteHash pair. A standalone hash, not a
# Permutation; no zk_dtypes / x64 dependency.
py_library(
    name = "sha512",
    srcs = ["sha512.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        ":word",
        ":word64",
        "//hash_frx/extension:md",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Byte-oriented BLAKE2s (RFC 7693, unkeyed): BLAKE2b's 32-bit sibling at
# native uint32 — the `digest` batch hash behind the `hash_frx.digest.blake2s`
# marker plus the `Blake2s` / `HostBlake2s` ByteHash pair. A standalone hash,
# not a Permutation; no zk_dtypes / x64 dependency.
py_library(
    name = "blake2s",
    srcs = ["blake2s.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        ":word",
        "//hash_frx/extension:pad",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Byte-oriented SM3 (GB/T 32905-2016; ISO/IEC 10118-3): the ShangMi
# ecosystem's hash, SHA-256's structural cousin — the `digest` batch hash
# behind the `hash_frx.digest.sm3` marker plus the `Sm3` / `HostSm3` ByteHash
# pair. A standalone hash, not a Permutation; no zk_dtypes / x64 dependency.
py_library(
    name = "sm3",
    srcs = ["sm3.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        ":word",
        "//hash_frx/extension:md",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Byte-oriented RIPEMD-160 (Dobbertin–Bosselaers–Preneel, ISO/IEC 10118-3;
# Bitcoin HASH160's second half): the `digest` batch hash behind the
# `hash_frx.digest.ripemd160` marker plus the `Ripemd160` ByteHash row. A
# standalone hash, not a Permutation; no zk_dtypes / x64 dependency. No host
# row ships — OpenSSL 3 moved RIPEMD-160 to the legacy provider, so the
# differential partner is testonly (//hash_frx/testing:host_ripemd160).
py_library(
    name = "ripemd160",
    srcs = ["ripemd160.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        ":fusion",
        ":word",
        "//hash_frx/extension:pad",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Padding-free overwrite sponge — the Merkle leaf hasher over a Permutation.
py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        ":permutation",
        requirement("frx"),
    ],
)

# Add-absorb duplex sponge — the interleaved absorb/squeeze sibling of `Sponge`,
# the primitive a Fiat-Shamir transcript drives.
py_library(
    name = "duplex_sponge",
    srcs = ["duplex_sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        ":permutation",
        requirement("frx"),
    ],
)

# Truncated-permutation compression — the n-to-1 Merkle fold over a Permutation.
py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        ":permutation",
        requirement("frx"),
    ],
)

# HMAC (FIPS 198-1) — the keyed MAC over a ByteHash. The block size rides the
# construction, not the seam.
py_library(
    name = "hmac",
    srcs = ["hmac.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# HKDF (RFC 5869) — extract-then-expand over HMAC, the KDF the composition
# standards (HPKE, TLS-style schedules) name.
py_library(
    name = "hkdf",
    srcs = ["hkdf.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":hmac",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# PBKDF2 (RFC 8018) — the iterated KDF over HMAC as a traced c-loop, with a
# midstate fast path over the SHA-2 modules' public compress machinery
# (hence the :sha256/:sha512 deps — the one construction that names hashes).
py_library(
    name = "pbkdf2",
    srcs = ["pbkdf2.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":hmac",
        ":sha256",
        ":sha512",
        requirement("frx"),
        requirement("numpy"),
    ],
)
