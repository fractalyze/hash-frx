load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "poseidon2",
    srcs = [
        "__init__.py",
        "linear.py",
        "params.py",
        "poseidon2.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hash_frx:fusion",
        "//hash_frx:linear",
        "//hash_frx:permutation",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The named standard parameter sets. A separate target from the engine on
# purpose: the engine is field-agnostic and deps no field, while a named set
# is a concrete parameterization over a concrete dtype and pulls `zk_dtypes`.
# Same split `adapter/block_size` makes for the same reason.
py_library(
    name = "standard",
    srcs = [
        "__init__.py",
        "standard.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":poseidon2",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)
