load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "babybear16",
    testonly = True,
    srcs = [
        "__init__.py",
        "babybear16.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
    deps = [
        "//hash_frx/poseidon2",
        "//hash_frx/poseidon2:standard",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "koalabear16",
    testonly = True,
    srcs = [
        "__init__.py",
        "koalabear16.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
    deps = [
        "//hash_frx/poseidon2",
        "//hash_frx/poseidon2:standard",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "poseidon2_test",
    size = "medium",
    srcs = ["poseidon2_test.py"],
    deps = [
        ":babybear16",
        ":koalabear16",
        "//hash_frx:_composite",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_recognized",
        "//hash_frx/testing:marker_seam",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "params_test",
    size = "small",
    srcs = ["params_test.py"],
    deps = [
        "//hash_frx/poseidon2",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permute_shape_test",
    size = "medium",
    srcs = ["permute_shape_test.py"],
    deps = [
        "//hash_frx/poseidon2",
        "//hash_frx/testing:fusion_ready",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "linear_test",
    size = "small",
    srcs = ["linear_test.py"],
    deps = [
        "//hash_frx/poseidon2",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:random_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# Carries the plugin deps despite asserting about imports: the test's whole
# point is that touching `KoalaBear16` builds it, and that construction reads
# `frx.default_backend()`, so the GPU leg needs the backend it names to exist.
py_test(
    name = "standard_test",
    size = "small",
    srcs = ["standard_test.py"],
    deps = [
        "//hash_frx/poseidon2:standard",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)
