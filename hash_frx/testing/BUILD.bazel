py_test(
    name = "sponge_test",
    # Compile-heavy: the scanned absorb path compiles a while loop per hash
    # shape, dominated by the vmapped one.
    size = "medium",
    srcs = ["sponge_test.py"],
    deps = [
        "//hash_frx:permutation",
        "//hash_frx:sponge",
        "//hash_frx/poseidon2",
        "//hash_frx/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

