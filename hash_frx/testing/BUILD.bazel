load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Deterministic random field elements, shared by every test in the package.
py_library(
    name = "random_field",
    testonly = True,
    srcs = [
        "__init__.py",
        "random_field.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//hash_frx",
        requirement("absl_py"),
    ],
)

# The registry's drift guard. The deps are its sweep's coverage boundary: the
# completeness case walks the package files these targets place in runfiles,
# so a new hash package joins this list when it joins the registry.
py_test(
    name = "markers_test",
    size = "small",
    srcs = ["markers_test.py"],
    # GPU_PLUGIN_DEPS despite touching no device: importing `sha256` (its
    # round-constant table) and `blake3.compress` (its IV words) puts arrays on
    # the default backend at module load, and the cuda leg refuses to
    # initialize without the plugin wheels in runfiles.
    deps = [
        "//hash_frx",
        "//hash_frx:markers",
        "//hash_frx:sha256",
        "//hash_frx:sha512",
        "//hash_frx:sponge",
        "//hash_frx/ascon",
        "//hash_frx/blake3",
        "//hash_frx/grostl",
        "//hash_frx/keccak",
        "//hash_frx/poseidon",
        "//hash_frx/poseidon2",
        "//hash_frx/vision",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

