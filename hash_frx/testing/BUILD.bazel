load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Deterministic random field elements, shared by every test in the package.
py_library(
    name = "random_field",
    testonly = True,
    srcs = [
        "__init__.py",
        "random_field.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//hash_frx",
        requirement("absl_py"),
    ],
)

py_test(
    name = "_composite_test",
    size = "small",
    srcs = ["_composite_test.py"],
    deps = [
        "//hash_frx:_composite",
        requirement("absl_py"),
        requirement("frx"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "fusion_test",
    size = "small",
    srcs = ["fusion_test.py"],
    deps = [
        ":random_field",
        "//hash_frx:fusion",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
