        "//hash_frx/ascon",
        "//hash_frx/blake2b",
        "//hash_frx/blake3",
        "//hash_frx/grostl",
        "//hash_frx/keccak",
        "//hash_frx/poseidon",
        "//hash_frx/poseidon2",
        "//hash_frx/poseidon2/testing:koalabear16",
        "//hash_frx/vision",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

