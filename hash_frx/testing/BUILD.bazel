# Drives the constructions over a machine-word permutation, so it depends on
# them rather than on the seam alone like `permutation_test` above.
py_test(
    name = "non_field_permutation_test",
    size = "small",
    srcs = ["non_field_permutation_test.py"],
    deps = [
        "//hash_frx:compression",
        "//hash_frx:permutation",
        "//hash_frx:sponge",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# No device work: pure numpy plus the `frx.typing` alias, so the CUDA plugin
