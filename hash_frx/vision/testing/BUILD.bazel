load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The plain-Python oracle: arbitrary-precision ints only, no frx, so the
# differential tests hold the frx implementation to something that shares none
# of its lowering rules.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# The canonical-int decode every device -> oracle handoff shares (kept out of
# `:reference`, which stays plain-Python-int only).
py_library(
    name = "decode",
    testonly = True,
    srcs = [
        "__init__.py",
        "decode.py",
    ],
    deps = [requirement("numpy")],
)

py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":decode",
        ":reference",
        "//hash_frx/vision",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "params_test",
    size = "small",
    srcs = ["params_test.py"],
    deps = [
        "//hash_frx/vision",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "linear_test",
    size = "small",
    srcs = ["linear_test.py"],
    deps = [
        ":decode",
        ":reference",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/vision",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "vision_test",
    # Compile-heavy: the generic `zorch.fused_region` marker routes the whole
    # 16-step body through loop fusion, and the suite compiles several aval /
    # routing configurations of it.
    size = "large",
    srcs = ["vision_test.py"],
    deps = [
        ":decode",
        ":reference",
        "//hash_frx:fusion",
        "//hash_frx:permutation",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_seam",
        "//hash_frx/vision",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
