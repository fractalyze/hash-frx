load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# Ascon-p[12] as a `Permutation` over uint32 word halves (NIST SP 800-232 §3) —
# the seam a generic sponge takes, and the round body the byte digest below runs
# inside its own marked region.
py_library(
    name = "permutation",
    srcs = [
        "__init__.py",
        "permutation.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hash_frx:fusion",
        "//hash_frx:word",
        "//hash_frx:word64",
        requirement("frx"),
    ],
)

# The byte-oriented NIST SP 800-232 hashes (the lightweight-cryptography
# standard): Ascon-Hash256, Ascon-XOF128 and Ascon-CXOF128 as `ByteHash` rows
# over uint32 lane halves, each behind its own `hash_frx.digest.*` marker. The
# standard's fourth function, Ascon-AEAD128, is a mode over ciphertext and
# belongs to enc-frx, which imports `:permutation` for it. A
# standalone hash, not a Permutation; no zk_dtypes / x64 dependency. The host
# differential partner is testonly
# (//hash_frx/ascon/testing:reference) — no C library implements
# Ascon.
py_library(
    name = "ascon",
    srcs = [
        "__init__.py",
        "ascon.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx:word",
        "//hash_frx/extension:pad",
        "//hash_frx/extension:sponge",
        requirement("frx"),
        requirement("numpy"),
    ],
)
