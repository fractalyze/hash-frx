load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The plain-python oracle: ints and bytes only, no frx, so the differential
# tests hold the frx implementation to something that shares none of its
# lowering rules (its S-box is the column-wise Table 6 lookup, not the
# bitsliced circuit; its words are Python ints, not uint32 half pairs).
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: plain python against the transcribed KAT, so the CUDA plugin
# wheels would be ~430 MB of runfiles for nothing.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        requirement("absl_py"),
    ],
)

py_test(
    name = "ascon_test",
    # Compile-heavy: the digest body splices twelve-round permutations per
    # 8-byte block plus the squeeze chain, and the KAT + differential sweeps
    # compile it once per (batch, length) aval.
    #
    # `timeout = "eternal"` on top of `large`, because the suite outgrew the
    # 900 s that size carries. Measured on the CI executor: 380-407 s before
    # Ascon-CXOF128 joined it, 740-790 s after — the third hash roughly doubled
    # the sweeps and nothing re-sized the target. At 88 % of budget `main` is
    # one slow worker from red, which is what it went when an unrelated branch
    # invalidated this target's cache and forced a real run.
    #
    # Headroom rather than a trim: the added coverage is the 1089-row CXOF KAT
    # and it is worth its seconds. If this has to come back down, the sweeps
    # are the place to look, not the vectors.
    size = "large",
    timeout = "eternal",
    srcs = ["ascon_test.py"],
    deps = [
        ":reference",
        "//hash_frx:byte_hash",
        "//hash_frx:fusion",
        "//hash_frx:word",
        "//hash_frx/ascon",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:oracle",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permutation_test",
    # Compile-heavy: twelve unrolled rounds, compiled once per routing and per
    # state aval, plus the exhaustive S-box circuit case.
    size = "large",
    srcs = ["permutation_test.py"],
    deps = [
        ":reference",
        "//hash_frx:fusion",
        "//hash_frx:permutation",
        "//hash_frx:word",
        "//hash_frx/ascon:permutation",
        "//hash_frx/testing:composite_eqn",
        "//hash_frx/testing:fusion_ready",
        "//hash_frx/testing:jit_cache",
        "//hash_frx/testing:marker_seam",
        "//hash_frx/testing:routing_mock",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
