load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# Merkle-Damgard: the schedule that feeds a `CompressionFunction`. Two halves —
# `PadRule`, host arithmetic over a message LENGTH and never its bytes, and
# `chain`, the marked compression loop. The second is device code, so this
# target does carry frx; it still materializes nothing at import.
py_library(
    name = "md",
    srcs = [
        "__init__.py",
        "md.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//hash_frx:fusion",
        requirement("frx"),
        requirement("numpy"),
    ],
)
