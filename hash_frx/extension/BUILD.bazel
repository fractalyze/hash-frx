load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# How a message becomes whole blocks. Host arithmetic over a message LENGTH and
# never its bytes, so this carries numpy and nothing else — seven families need
# the padding rule and four of them need nothing else from `extension/`, so
# making them take frx to get it was 536 MB of runfiles for a host `np.zeros`.
py_library(
    name = "pad",
    srcs = [
        "__init__.py",
        "pad.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("numpy")],
)

# The schedules that feed a permutation a message: the static-count byte one
# both byte sponges take, and the runtime-count field one. Device code, hence
# frx — but it emits no op of its own, every array operation reaching it through
# the caller's callbacks.
py_library(
    name = "sponge",
    srcs = [
        "__init__.py",
        "sponge.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# The schedules that feed the padded blocks to a compression: the one-shot
# marked region and the incremental midstate. Device code, hence frx.
py_library(
    name = "md",
    srcs = [
        "__init__.py",
        "md.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":pad",
        "//hash_frx:fusion",
        requirement("frx"),
    ],
)

# The schedule that folds a message's chunks down to one root node. Host
# arithmetic and control flow only — every array operation reaches it through
# the caller's callbacks — so it carries NO dependency at all, not even numpy.
# `pad` states why that is worth keeping rather than a coincidence: a dep here
# is a dep for every family that needs the rule.
py_library(
    name = "tree",
    srcs = [
        "__init__.py",
        "tree.py",
    ],
    visibility = ["//visibility:public"],
)
