load("@hash_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Plain-python BLAKE3, the oracle compress_test is held to.
py_library(
    name = "reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "reference.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# The BLAKE3 team's published vectors, shared by both tests below.
py_library(
    name = "vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "vectors.py",
    ],
    visibility = ["//hash_frx:__subpackages__"],
)

# No device work: the oracle against the published vectors, pure python.
py_test(
    name = "reference_test",
    size = "small",
    srcs = ["reference_test.py"],
    deps = [
        ":reference",
        ":vectors",
        requirement("absl_py"),
    ],
)

py_test(
    name = "compress_test",
    size = "medium",
    srcs = ["compress_test.py"],
    deps = [
        ":reference",
        ":vectors",
        "//hash_frx/blake3",
        "//hash_frx/testing:fusion_ready",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "blake3_test",
    size = "medium",
    srcs = ["blake3_test.py"],
    deps = [
        ":reference",
        ":vectors",
        "//hash_frx/blake3",
        "//hash_frx/testing:fusion_ready",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
